{
  "env": {
    "ANTHROPIC_API_KEY": ""
  },
  "permissions": {
    "allow": [
      "mcp__plugin_context-mode_context-mode__ctx_execute",
      "WebSearch",
      "mcp__plugin_context-mode_context-mode__ctx_index",
      "mcp__plugin_context-mode_context-mode__ctx_search",
      "mcp__plugin_context-mode_context-mode__ctx_doctor",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__plugin_context-mode_context-mode__ctx_resume",
      "Bash(git *)",
      "Bash(docker exec docukore-postgres *)",
      "Bash(powershell.exe *)",
      "Bash(docker start *)",
      "Bash(java -version)",
      "Bash(command -v java)",
      "Bash(command -v mvn)",
      "Bash(command -v node)",
      "Bash(command -v npm)",
      "Bash(cmd.exe *)",
      "Bash(docker version *)",
      "Bash(python *)",
      "Bash(./mvnw compile *)",
      "Bash(mvn *)",
      "Bash(powershell -Command \"Get-Content checkstyle.xml\")",
      "mcp__idea__read_file",
      "Skill(claude-api)",
      "mcp__idea__list_directory_tree",
      "Bash(psql *)",
      "Bash(./mvnw -q flyway:info -Dflyway.configFiles=src/test/resources/flyway-test.properties)",
      "Bash(./mvnw *)",
      "Bash(cd *)",
      "Bash(./mvnw test *)",
      "Read(//tmp/**)",
      "Bash(export *)",
      "Bash(findstr /i \"JavadocType\" /tmp/checkstyle_full.txt)",
      "Bash(tee /tmp/checkstyle_full.txt)",
      "Bash(./backend/mvnw *)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "context7"
  ],
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context-mode@context-mode": true
  }
}
