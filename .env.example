# Copy to .env and replace placeholders with this workstation's existing credentials.
# Literal KEY=VALUE format; optional single/double quotes, no variable expansion.
DOCUKORE_TEST_JDBC_URL='<jdbc:postgresql://host:port/docukore_test>'
DOCUKORE_TEST_USERNAME='<existing-test-username>'
DOCUKORE_TEST_PASSWORD='<existing-test-password>'

# HOSTED only: choose GMAIL_API or RESEND explicitly. LOCAL ignores all mail settings.
# Blank alternative-provider values may remain blank. The test runner does not load mail keys.
DOCUKORE_MAIL_PROVIDER=GMAIL_API
DOCUKORE_MAIL_GMAIL_CLIENT_ID='<web-application-oauth-client-id>'
DOCUKORE_MAIL_GMAIL_CLIENT_SECRET='<web-application-oauth-client-secret>'
# Leave blank until the administrator runs node scripts/authorize-gmail.mjs.
DOCUKORE_MAIL_GMAIL_REFRESH_TOKEN=
DOCUKORE_MAIL_GMAIL_SENDER='<central-gmail-sender-address>'
DOCUKORE_MAIL_GMAIL_REDIRECT_URI=http://127.0.0.1:8765/oauth2/callback
# Required trusted, reachable HTTPS frontend URL. Do not substitute an incoming Host header.
DOCUKORE_SIGNUP_APPBASEURI='<trusted-https-frontend-base-url>'

# Alternative provider (direct Spring binding: api-key becomes APIKEY, not API_KEY).
DOCUKORE_MAIL_RESEND_APIKEY=
DOCUKORE_MAIL_RESEND_SENDER=
