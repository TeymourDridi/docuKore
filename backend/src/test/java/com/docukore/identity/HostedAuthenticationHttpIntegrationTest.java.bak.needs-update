package com.docukore.identity;

import com.docukore.DocukoreApplication;
import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.test.web.server.LocalServerPort;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.test.annotation.DirtiesContext;
import org.springframework.test.context.TestConstructor;

import javax.sql.DataSource;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.util.UUID;

import static org.junit.jupiter.api.Assertions.*;

@SpringBootTest(classes = DocukoreApplication.class, webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT,
    properties = "spring.flyway.baseline-on-migrate=false")
@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_CLASS)
@TestConstructor(autowireMode = TestConstructor.AutowireMode.ALL)
class HostedAuthenticationHttpIntegrationTest extends SharedSpringBootTest {

    private final int port;
    private final JdbcTemplate jdbc;
    private final PasswordEncoder passwords;
    private final HttpClient client = HttpClient.newHttpClient();

    HostedAuthenticationHttpIntegrationTest(@LocalServerPort int port, DataSource dataSource, PasswordEncoder passwords) {
        this.port = port;
        this.jdbc = new JdbcTemplate(dataSource);
        this.passwords = passwords;
    }

    @Test
    void defaultHostedModeRejectsSetupAndWritesSecureCookiesWithoutActivationShortcut() throws Exception {
        assertTrue(get("/api/auth/setup").body().contains("\"available\":false"));
        var csrf = get("/api/auth/csrf");
        String cookie = csrf.headers().allValues("Set-Cookie").stream().filter(c -> c.startsWith("XSRF-TOKEN=")).findFirst().orElseThrow();
        assertTrue(cookie.contains("Secure") && cookie.contains("SameSite=Lax") && cookie.contains("Path=/") && !cookie.contains("HttpOnly"));
        String token = cookie.substring("XSRF-TOKEN=".length(), cookie.indexOf(';'));
        assertEquals(404, post("/api/auth/setup", AuthenticationHttpIntegrationTest.setupBody(), "application/json", token).statusCode());
        assertEquals(0, jdbc.queryForObject("SELECT count(*) FROM public.users", Integer.class));
        assertNull(jdbc.queryForObject("SELECT completed_at FROM public.installation_setup WHERE id=1", Object.class));
        String hash = passwords.encode("Fictional-hosted-passphrase!");
        jdbc.update("""
            INSERT INTO public.users (id,username,username_normalized,email,email_normalized,password_hash,
                deployment_mode,created_at,account_status)
            VALUES (?, 'pending', 'pending', 'pending@example.invalid', 'pending@example.invalid', ?, 'hosted', now(), 'PENDING_ACTIVATION')
            """, UUID.randomUUID(), hash);
        var pending = post("/api/auth/login", AuthenticationHttpIntegrationTest.credentials("pending", "Fictional-hosted-passphrase!"), "application/x-www-form-urlencoded", token);
        var unknown = post("/api/auth/login", AuthenticationHttpIntegrationTest.credentials("unknown", "Fictional-hosted-passphrase!"), "application/x-www-form-urlencoded", token);
        assertEquals(401, pending.statusCode());
        assertEquals(unknown.body(), pending.body());
        assertNull(jdbc.queryForObject("SELECT activated_at FROM public.users WHERE username='pending'", Object.class));
        // Only a test fixture simulates an already verified hosted identity; there is no activation API.
        jdbc.update("""
            INSERT INTO public.users (id,username,username_normalized,email,email_normalized,password_hash,
                deployment_mode,created_at,activated_at,account_status)
            VALUES (?, 'verified', 'verified', 'verified@example.invalid', 'verified@example.invalid', ?, 'hosted', now(), now(), 'ACTIVE')
            """, UUID.randomUUID(), hash);
        var login = post("/api/auth/login", AuthenticationHttpIntegrationTest.credentials("verified", "Fictional-hosted-passphrase!"), "application/x-www-form-urlencoded", token);
        assertEquals(200, login.statusCode());
        assertTrue(login.headers().allValues("Set-Cookie").stream().anyMatch(c -> c.startsWith("SESSION=") && c.contains("Secure") && c.contains("HttpOnly") && c.contains("SameSite=Lax") && c.contains("Path=/") && !c.contains("Domain=")));
        assertEquals(1, jdbc.queryForObject("SELECT count(*) FROM public.spring_session", Integer.class));
    }

    private HttpResponse<String> get(String path) throws Exception {
        return client.send(HttpRequest.newBuilder(URI.create("http://localhost:" + port + path)).GET().build(), HttpResponse.BodyHandlers.ofString());
    }

    private HttpResponse<String> post(String path, String body, String type, String token) throws Exception {
        // Manually replay the Secure token to inspect policy over real HTTP; no forwarded-header trust.
        return client.send(HttpRequest.newBuilder(URI.create("http://localhost:" + port + path))
            .header("Content-Type", type).header("Cookie", "XSRF-TOKEN=" + token).header("X-XSRF-TOKEN", token)
            .POST(HttpRequest.BodyPublishers.ofString(body)).build(), HttpResponse.BodyHandlers.ofString());
    }
}