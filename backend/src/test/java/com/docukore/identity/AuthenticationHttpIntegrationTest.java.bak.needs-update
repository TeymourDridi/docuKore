package com.docukore.identity;

import com.docukore.DocukoreApplication;
import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.test.web.server.LocalServerPort;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.security.crypto.factory.PasswordEncoderFactories;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.test.annotation.DirtiesContext;
import org.springframework.test.context.TestConstructor;

import javax.sql.DataSource;
import java.net.CookieManager;
import java.net.CookiePolicy;
import java.net.URI;
import java.net.URLEncoder;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.charset.StandardCharsets;
import java.util.concurrent.CyclicBarrier;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;

import static org.junit.jupiter.api.Assertions.*;

@SpringBootTest(classes = DocukoreApplication.class, webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT,
    properties = {"docukore.deployment.mode=local", "spring.flyway.baseline-on-migrate=false"})
@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_CLASS)
@TestConstructor(autowireMode = TestConstructor.AutowireMode.ALL)
class AuthenticationHttpIntegrationTest extends SharedSpringBootTest {

    private final int port;
    private final JdbcTemplate jdbc;
    private static final String PASSWORD = "Fictional-test-passphrase!";

    AuthenticationHttpIntegrationTest(@LocalServerPort int port, DataSource dataSource) {
        this.port = port;
        this.jdbc = new JdbcTemplate(dataSource);
    }

    @Test
    void firstOwnerRaceThenRealLoginCsrfSessionAndLogout() throws Exception {
        Browser first = new Browser(port);
        Browser second = new Browser(port);
        var csrfResponse = first.get("/api/auth/csrf");
        assertEquals(204, csrfResponse.statusCode());
        assertTrue(csrfResponse.headers().allValues("Set-Cookie").stream().anyMatch(c -> c.startsWith("XSRF-TOKEN=") && c.contains("Path=/") && c.contains("SameSite=Lax") && !c.contains("HttpOnly") && !c.contains("Secure")));
        assertEquals(401, first.get("/api/auth/me").statusCode());
        assertEquals(401, first.get("/api/protected").statusCode());
        assertTrue(first.get("/api/auth/setup").body().contains("\"available\":true"));
        assertEquals(403, first.post("/api/auth/setup", setupBody(), "application/json", false).statusCode());
        assertEquals(403, first.post("/api/auth/login", credentials("doctor", PASSWORD), "application/x-www-form-urlencoded", false).statusCode());
        second.get("/api/auth/csrf");
        assertEquals(400, first.post("/api/auth/setup", "{\"username\":\"x\",\"fullName\":\"\",\"password\":\"short\"}", "application/json", true).statusCode());
        assertEquals(403, first.invalidCsrf("/api/auth/setup", setupBody(), "application/json").statusCode());
        var barrier = new CyclicBarrier(2);
        try (var workers = Executors.newFixedThreadPool(2)) {
            var a = workers.submit(() -> { barrier.await(10, TimeUnit.SECONDS); return first.post("/api/auth/setup", setupBody(), "application/json", true).statusCode(); });
            var b = workers.submit(() -> { barrier.await(10, TimeUnit.SECONDS); return second.post("/api/auth/setup", setupBody(), "application/json", true).statusCode(); });
            int one = a.get(20, TimeUnit.SECONDS);
            int two = b.get(20, TimeUnit.SECONDS);
            assertTrue((one == 201 && two == 409) || (one == 409 && two == 201));
        }
        assertEquals(1, jdbc.queryForObject("SELECT count(*) FROM public.users", Integer.class));
        assertNotNull(jdbc.queryForObject("SELECT completed_at FROM public.installation_setup WHERE id=1", Object.class));
        assertEquals(0, jdbc.queryForObject("SELECT count(*) FROM public.cabinets", Integer.class));
        var encoder = PasswordEncoderFactories.createDelegatingPasswordEncoder();
        String hash = jdbc.queryForObject("SELECT password_hash FROM public.users", String.class);
        assertNotEquals(PASSWORD, hash);
        assertTrue(encoder.matches(PASSWORD, hash));
        assertNull(jdbc.queryForObject("SELECT email FROM public.users", String.class));
        assertFalse(first.get("/api/auth/setup").body().contains("\"available\":true"));
        assertEquals(409, first.post("/api/auth/setup", setupBody(), "application/json", true).statusCode());

        var unknown = first.post("/api/auth/login", credentials("unknown", PASSWORD), "application/x-www-form-urlencoded", true);
        var wrong = first.post("/api/auth/login", credentials("doctor", "incorrect"), "application/x-www-form-urlencoded", true);
        assertEquals(401, unknown.statusCode());
        assertEquals(unknown.body(), wrong.body());
        var overlong = first.post("/api/auth/login", credentials("doctor", "a".repeat(73)), "application/x-www-form-urlencoded", true);
        assertEquals(401, overlong.statusCode());
        assertEquals(unknown.body(), overlong.body());
        var login = first.post("/api/auth/login", credentials(" DOCTOR ", PASSWORD), "application/x-www-form-urlencoded", true);
        assertEquals(200, login.statusCode());
        assertTrue(login.headers().allValues("Set-Cookie").stream().anyMatch(c -> c.startsWith("SESSION=") && c.contains("Path=/") && c.contains("SameSite=Lax") && c.contains("HttpOnly") && !c.contains("Secure") && !c.contains("Domain=")));
        assertEquals(1, jdbc.queryForObject("SELECT count(*) FROM public.spring_session", Integer.class));

        var me = first.get("/api/auth/me");
        assertEquals(200, me.statusCode());
        assertTrue(me.body().contains("\"username\":\"doctor\""));
        var logout = first.post("/api/auth/logout", "", "application/json", true);
        assertEquals(204, logout.statusCode());
        assertEquals(401, first.get("/api/auth/me").statusCode());
        assertEquals(0, jdbc.queryForObject("SELECT count(*) FROM public.spring_session", Integer.class));
    }

    static String setupBody() {
        return "{\"username\":\"doctor\",\"fullName\":\"Fictional Doctor\",\"email\":\"doctor@fictional.invalid\",\"password\":\"Fictional-test-passphrase!\"}";
    }

    static String credentials(String username, String password) {
        return "username=" + URLEncoder.encode(username, StandardCharsets.UTF_8) + "&password=" + URLEncoder.encode(password, StandardCharsets.UTF_8);
    }

    static class Browser {
        private final int port;
        private final HttpClient client = HttpClient.newBuilder().cookieHandler(new CookieManager(null, CookiePolicy.ACCEPT_ALL)).build();
        private String token;

        Browser(int port) {
            this.port = port;
        }

        HttpResponse<String> get(String path) throws Exception {
            return client.send(HttpRequest.newBuilder(URI.create("http://localhost:" + port + path)).GET().build(), HttpResponse.BodyHandlers.ofString());
        }

        HttpResponse<String> post(String path, String body, String type, boolean csrf) throws Exception {
            var builder = HttpRequest.newBuilder(URI.create("http://localhost:" + port + path))
                .header("Content-Type", type);
            if (csrf) {
                builder.header("Cookie", "XSRF-TOKEN=" + token).header("X-XSRF-TOKEN", token);
            }
            return client.send(builder.POST(HttpRequest.BodyPublishers.ofString(body)).build(), HttpResponse.BodyHandlers.ofString());
        }

        HttpResponse<String> invalidCsrf(String path, String body, String type) throws Exception {
            return client.send(HttpRequest.newBuilder(URI.create("http://localhost:" + port + path))
                .header("Content-Type", type)
                .header("Cookie", "XSRF-TOKEN=invalid").header("X-XSRF-TOKEN", "invalid")
                .POST(HttpRequest.BodyPublishers.ofString(body)).build(), HttpResponse.BodyHandlers.ofString());
        }
    }
}