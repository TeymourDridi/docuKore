package com.docukore.tenant;

import com.docukore.DocukoreApplication;
import com.docukore.identity.CurrentAccount;
import com.docukore.support.SharedPostgresTest;
import com.docukore.support.SharedSpringBootTest;
import com.docukore.support.TestFixtures;
import com.zaxxer.hikari.HikariDataSource;
import jakarta.persistence.EntityManagerFactory;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.CsvSource;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.orm.jpa.EntityManagerFactoryUtils;
import org.springframework.security.access.AccessDeniedException;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
import org.springframework.security.core.authority.AuthorityUtils;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.security.core.userdetails.User;
import org.springframework.test.annotation.DirtiesContext;
import org.springframework.test.context.TestConstructor;
import org.springframework.transaction.PlatformTransactionManager;
import org.springframework.transaction.support.TransactionTemplate;

import java.sql.Connection;
import java.util.UUID;
import java.util.concurrent.atomic.AtomicBoolean;
import java.util.function.Supplier;

import static org.junit.jupiter.api.Assertions.*;

@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_CLASS)
@TestConstructor(autowireMode = TestConstructor.AutowireMode.ALL)
class AuthorizedCabinetAccessIntegrationTest extends SharedSpringBootTest {

    private static final UUID PROBE_ID = UUID.fromString("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa");
    private final AuthorizedCabinetAccess access;
    private final CurrentAccount currentAccount;
    private final EntityManagerFactory entityManagers;
    private final HikariDataSource dataSource;
    private final JdbcTemplate jdbc;
    private final TransactionTemplate transactions;
    private final TransactionTemplate platformTransactions;
    private UUID owner;
    private UUID member;
    private UUID otherOwner;
    private TestFixtures.CabinetFixture first;
    private TestFixtures.CabinetFixture second;

    AuthorizedCabinetAccessIntegrationTest(AuthorizedCabinetAccess access, CurrentAccount currentAccount,
                                          EntityManagerFactory entityManagers, HikariDataSource dataSource,
                                          @Qualifier("transactionManager") PlatformTransactionManager tenantManager,
                                          @Qualifier("platformTransactionManager") PlatformTransactionManager platformManager) {
        this.access = access;
        this.currentAccount = currentAccount;
        this.entityManagers = entityManagers;
        this.dataSource = dataSource;
        this.jdbc = new JdbcTemplate(dataSource);
        this.transactions = new TransactionTemplate(tenantManager);
        this.platformTransactions = new TransactionTemplate(platformManager);
    }

    @BeforeEach
    void fixtures() {
        owner = account();
        member = account();
        otherOwner = account();
        first = TestFixtures.createCabinetWithOwner(jdbc);
        second = TestFixtures.createCabinetWithOwner(jdbc);
        TestFixtures.createTenantProbeTable(jdbc, first.schemaName());
        TestFixtures.createTenantProbeTable(jdbc, second.schemaName());
        membership(first.cabinetId(), owner, "OWNER", "DOCTOR");
        membership(first.cabinetId(), member, "MEMBER", "SECRETARY");
        membership(second.cabinetId(), otherOwner, "OWNER", "DOCTOR");
    }

    @AfterEach
    void clearSecurity() {
        try {
            assertFalse(TenantContext.isPresent());
        } finally {
            SecurityContextHolder.clearContext();
            TenantContext.clear();
        }
    }

    @Test
    void ownerAndMemberUseCurrentIdentityAndEnterTrustedCabinetWithoutClinicalGrants() {
        authenticate(owner);
        assertEquals(owner, currentAccount.requireId());
        assertEquals(first.cabinetId(), access.execute(first.cabinetId(), TenantContext::requireCabinetId));
        authenticate(member);
        assertEquals(member, currentAccount.requireId());
        assertEquals(first.cabinetId(), access.execute(first.cabinetId(), TenantContext::requireCabinetId));
        assertEquals(0, jdbc.queryForObject("SELECT count(*) FROM public.membership_permissions", Integer.class));
    }

    @Test
    void anotherCabinetAndOwnerWithoutMembershipAreDeniedBeforeBusinessWork() {
        authenticate(owner);
        denied(AccessDeniedException.class, second);
        jdbc.update("DELETE FROM public.cabinet_memberships WHERE cabinet_id = ? AND user_id = ?", first, owner);
        denied(AccessDeniedException.class, first);
    }

    @ParameterizedTest
    @CsvSource({"INACTIVE,false", "PENDING_INVITATION,false", "ACTIVE,true", "INACTIVE,true"})
    void inactivePendingOrRevokedMembershipCannotExecuteBusinessOperations(String status, boolean revoked) {
        authenticate(member);
        jdbc.update("UPDATE public.cabinet_memberships SET status = ?, revoked_at = CASE WHEN ? THEN now() ELSE NULL END WHERE cabinet_id = ? AND user_id = ?",
            status, revoked, first, member);
        denied(AccessDeniedException.class, first);
    }

    @Test
    void membershipIsRecheckedOnEachInvocationIncludingRevocationAndDeletion() {
        authenticate(member);
        assertEquals(first.cabinetId(), access.execute(first.cabinetId(), TenantContext::requireCabinetId));
        jdbc.update("UPDATE public.cabinet_memberships SET revoked_at = now() WHERE cabinet_id = ? AND user_id = ?", first, member);
        denied(AccessDeniedException.class, first);
        jdbc.update("DELETE FROM public.cabinet_memberships WHERE cabinet_id = ? AND user_id = ?", first, member);
        denied(AccessDeniedException.class, first);
    }

    @Test
    void sameIdsAreIsolatedAndPhysicalConnectionIsResetAfterSuccessfulAndFailedTransactions() throws Exception {
        authenticate(owner);
        int pid = access.execute(first.cabinetId(), () -> transaction(() -> {
            var em = EntityManagerFactoryUtils.getTransactionalEntityManager(entityManagers);
            assertNotNull(em);
            assertEquals(first.schemaName(), em.createNativeQuery("SELECT current_schema()", String.class).getSingleResult());
            em.persist(new TenantProbe(PROBE_ID, "FIRST"));
            return (Integer) em.createNativeQuery("SELECT pg_backend_pid()", Integer.class).getSingleResult();
        }));
        authenticate(otherOwner);
        assertEquals(Integer.valueOf(pid), access.execute(second.cabinetId(), () -> transaction(() -> {
            var em = EntityManagerFactoryUtils.getTransactionalEntityManager(entityManagers);
            assertNotNull(em);
            assertNull(em.find(TenantProbe.class, PROBE_ID));
            em.persist(new TenantProbe(PROBE_ID, "SECOND"));
            return (Integer) em.createNativeQuery("SELECT pg_backend_pid()", Integer.class).getSingleResult();
        })));
        assertThrows(RuntimeException.class, () -> access.execute(second.cabinetId(), () -> transaction(() -> {
            var em = EntityManagerFactoryUtils.getTransactionalEntityManager(entityManagers);
            assertNotNull(em);
            em.find(TenantProbe.class, PROBE_ID).marker("ROLLBACK");
            em.flush();
            em.createNativeQuery("SELECT 1 / 0", Integer.class).getSingleResult();
            return null;
        })));
        assertFalse(TenantContext.isPresent());
        assertEquals("SECOND", access.execute(second.cabinetId(), () -> transaction(() -> {
            var em = EntityManagerFactoryUtils.getTransactionalEntityManager(entityManagers);
            assertNotNull(em);
            return em.find(TenantProbe.class, PROBE_ID).marker();
        })));
        authenticate(owner);
        assertEquals("FIRST", access.execute(first.cabinetId(), () -> transaction(() -> {
            var em = EntityManagerFactoryUtils.getTransactionalEntityManager(entityManagers);
            assertNotNull(em);
            return em.find(TenantProbe.class, PROBE_ID).marker();
        })));
        try (Connection connection = dataSource.getConnection(); var statement = connection.createStatement()) {
            assertEquals("public", connection.getSchema());
            try (var rows = statement.executeQuery("SELECT pg_backend_pid()")) {
                assertTrue(rows.next());
                assertEquals(pid, rows.getInt(1));
            }
        }
    }

    private UUID account() {
        UUID id = UUID.randomUUID();
        jdbc.update("""
            INSERT INTO public.users (id, username, username_normalized, password_hash, deployment_mode,
                account_status, activated_at, created_at)
            VALUES (?, ?, ?, 'fictional', 'local', 'ACTIVE', now(), now())
            """, id, id.toString(), id.toString());
        return id;
    }

    private UUID cabinet(UUID cabinetOwner) {
        return createCabinetWithAllocation(cabinetOwner);
    }

    private String schema(UUID cabinet) {
        // Return the sequential schema name from the cabinets table to match V10 allocation
        return jdbc.queryForObject("SELECT schema_name FROM public.cabinets WHERE id = ?", String.class, cabinet);
    }

    // V10-compliant cabinet creation using Spring's JdbcTemplate (platform schema = public)
    private UUID createCabinetWithAllocation(UUID ownerId) {
        UUID cabinetId = UUID.randomUUID();
        UUID reservationId = UUID.randomUUID();
        Long schemaNumber = jdbc.queryForObject(
            "SELECT nextval('public.cabinet_schema_number_seq')", Long.class);
        String sequentialSchemaName = "cabinet" + String.format("%05d", schemaNumber);

        jdbc.update("""
            INSERT INTO public.cabinet_schema_allocations
                (reservation_id, cabinet_id, allocation_kind, schema_number, schema_name, allocated_at)
            VALUES (?, ?, 'SEQUENTIAL', ?, ?, CURRENT_TIMESTAMP)
            """, reservationId, cabinetId, schemaNumber, sequentialSchemaName);

        // Use sequential schema name in cabinets table to match V10 trigger validation
        jdbc.update("""
            INSERT INTO public.cabinets (id, owner_id, name, schema_name, provisioning_status, created_at, provisioned_at)
            VALUES (?, ?, 'Fictional cabinet', ?, 'ACTIVE', now(), now())
            """, cabinetId, ownerId, sequentialSchemaName);

        // Create tenant schema using sequential name (matching V10 allocation)
        jdbc.execute("CREATE SCHEMA " + sequentialSchemaName);
        org.flywaydb.core.Flyway.configure()
            .dataSource(SharedPostgresTest.SHARED_JDBC_URL, SharedPostgresTest.SHARED_USER, SharedPostgresTest.SHARED_PASSWORD)
            .schemas(sequentialSchemaName).locations("classpath:db/migration/tenant")
            .table("flyway_schema_history_tenant").load().migrate();

        // Create tenant_probe table in tenant schema (needed for test assertions)
        jdbc.execute("CREATE TABLE " + sequentialSchemaName + ".tenant_probe (id uuid primary key, marker varchar(255) not null)");

        return cabinetId;
    }

    private void membership(UUID cabinet, UUID account, String role, String staffType) {
        jdbc.update("INSERT INTO public.cabinet_memberships (id, cabinet_id, user_id, membership_role, staff_type, status) VALUES (?, ?, ?, ?, ?, 'ACTIVE')",
            UUID.randomUUID(), cabinet, account, role, staffType);
    }

    private static User principal(UUID account) {
        return new User(account.toString(), "fictional", AuthorityUtils.createAuthorityList("ACCOUNT"));
    }

    private static void authenticate(UUID account) {
        SecurityContextHolder.getContext().setAuthentication(UsernamePasswordAuthenticationToken.authenticated(
            principal(account), null, AuthorityUtils.createAuthorityList("ACCOUNT")));
    }

    private <E extends Throwable> E denied(Class<E> type, UUID cabinet) {
        var called = new AtomicBoolean();
        E failure = assertThrows(type, () -> access.execute(cabinet, () -> {
            called.set(true);
            return null;
        }));
        assertFalse(called.get(), "Denied operation executed tenant business work");
        assertFalse(TenantContext.isPresent());
        return failure;
    }

    private <T> T transaction(Supplier<T> action) {
        return transactions.execute(status -> action.get());
    }
}