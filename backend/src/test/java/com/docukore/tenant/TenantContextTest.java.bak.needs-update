package com.docukore.tenant;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.Test;

import java.util.UUID;

import static org.junit.jupiter.api.Assertions.*;

class TenantContextTest {

    private static final UUID FIRST = UUID.fromString("11111111-1111-1111-1111-111111111111");
    private static final UUID SECOND = UUID.fromString("22222222-2222-2222-2222-222222222222");

    @AfterEach
    void clearThread() {
        TenantContext.clear();
    }

    @Test
    void absentContextFailsClosed() {
        assertThrows(IllegalStateException.class, TenantContext::requireCabinetId);
        assertThrows(IllegalStateException.class, () -> new CabinetTenantIdentifierResolver().resolveCurrentTenantIdentifier());
        assertThrows(IllegalStateException.class, () -> new CabinetTenantSchemaMapper().schemaName(FIRST));
    }

    @Test
    void scopedContextClearsAfterExceptionAndRejectsNesting() {
        assertThrows(IllegalArgumentException.class, () -> {
            try (var ignored = TenantContext.open(FIRST, CabinetTenantSchemaMapper.derivedSchemaName(FIRST))) {
                assertEquals(FIRST, TenantContext.requireCabinetId());
                assertThrows(IllegalStateException.class, () -> TenantContext.open(SECOND, CabinetTenantSchemaMapper.derivedSchemaName(SECOND)));
                throw new IllegalArgumentException("Fictional failure");
            }
        });
        assertThrows(IllegalStateException.class, TenantContext::requireCabinetId);
    }

    @Test
    void mapperAcceptsOnlyMatchingTrustedUuid() {
        try (var ignored = TenantContext.open(FIRST, CabinetTenantSchemaMapper.derivedSchemaName(FIRST))) {
            var mapper = new CabinetTenantSchemaMapper();
            assertEquals(CabinetTenantSchemaMapper.derivedSchemaName(FIRST), mapper.schemaName(FIRST));
            assertThrows(IllegalStateException.class, () -> mapper.schemaName(SECOND));
            assertThrows(IllegalArgumentException.class, () -> mapper.schemaName(null));
        }
    }

    @Test
    void contextIsNotInheritedByOtherThreads() throws Exception {
        try (var ignored = TenantContext.open(FIRST, CabinetTenantSchemaMapper.derivedSchemaName(FIRST))) {
            try (var executor = java.util.concurrent.Executors.newSingleThreadExecutor()) {
                assertTrue(executor.submit(() -> !TenantContext.isPresent()).get());
            }
            assertEquals(FIRST, TenantContext.requireCabinetId());
        }
    }

    @Test
    void closingOldScopeTwiceCannotClearNewContext() {
        var old = TenantContext.open(FIRST, CabinetTenantSchemaMapper.derivedSchemaName(FIRST));
        old.close();
        try (var current = TenantContext.open(SECOND, CabinetTenantSchemaMapper.derivedSchemaName(SECOND))) {
            old.close();
            assertEquals(SECOND, TenantContext.requireCabinetId());
        }
    }

    @Test
    void nullAndNilCabinetIdsAreRejected() {
        assertThrows(IllegalArgumentException.class, () -> TenantContext.open(null, "test_schema"));
        assertThrows(IllegalArgumentException.class, () -> TenantContext.open(new UUID(0, 0), "test_schema"));
        assertThrows(IllegalArgumentException.class, () -> TenantContext.open(FIRST, null));
        assertThrows(IllegalArgumentException.class, () -> TenantContext.open(FIRST, ""));
        assertThrows(IllegalArgumentException.class, () -> TenantContext.open(FIRST, "   "));
    }
}
